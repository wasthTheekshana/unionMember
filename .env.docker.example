# Copy to ".env" (same folder as docker-compose.yml) on the server and fill in.
# ".env" is never committed. Do not paste these values into chats or logs.

POSTGRES_DB=samithiya
POSTGRES_USER=samithiya
# A strong database password, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=<generate>

# Random secret for login tokens (32+ characters). The app refuses to start in
# production with a short or placeholder value. Generate with:
#   openssl rand -hex 48
JWT_SECRET=<generate>
