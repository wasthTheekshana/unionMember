DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<a real database password>
DB_NAME=samithiya

PORT=5000
NODE_ENV=development

# Generate a random secret (at least 32 characters) for every environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# With NODE_ENV=production the server refuses to start if this is short or a placeholder.
JWT_SECRET=<generate-a-random-secret>

# Optional
# Allowed browser origins if the frontend is served from a DIFFERENT origin than the API
# (comma separated). Leave unset when nginx serves both - CORS is then off.
# CORS_ORIGIN=https://members.example.org
# Failed logins allowed per username+address in 15 minutes (default 5).
# LOGIN_MAX_ATTEMPTS=5
